#!/bin/bash
#OAR --project siconos
#OAR -l /nodes=1/cpu=2/core=16,walltime=1:00:00
################################################################################
set -e
mydir=`dirname $0`
time=`which time`
timer=""
timer_args=""
python_version=`python3 -c 'import sys; print(".".join(map(str, sys.version_info[:2])))'`
python_site_packages_path=`python3 -c 'import os; import sys; print(os.path.join(sys.prefix, "lib", "python" + sys.version[:4], "site-packages"))'`
venv=${VRUN_VENV:-venv}
VRUN_GUIX_CXX_TOOLCHAIN=${VRUN_GUIX_CXX_TOOLCHAIN:-clang-toolchain@19}
VRUN_GUIX_BASE_DIR=${VRUN_GUIX_BASE_DIR:-`pwd`}
case $VRUN_SETX in 1) set -x;; esac
while [ $# -gt 0 ]; do
  case $1 in

    --guix-base-dir)
      shift
      VRUN_GUIX_BASE_DIR=$1
      shift
      ;;

    -x)
      shift
      set -x
      export VRUN_SETX=1
      ;;

    --ssh)
      shift
      host=$1
      shift
      pwd=`pwd`
      echo $PYTHONPATH
      ssh -o SendEnv=LD_LIBRARY_PATH,PYTHONPATH -x $host "cd $pwd && $0 $@"
      ;;

    --fast)
      shift
      pwd=`pwd`
      unset GUIX_PROFILE
      export GUIX_PROFILE=$pwd/.siconos-guix-profile
      . ${GUIX_PROFILE}/etc/profile

      export PYTHONPATH=$GUIX_PYTHONPATH:$PYTHONPATH
      exec $0 "$@"
      ;;

    --gcc)
      shift
      export VRUN_GUIX_CXX_TOOLCHAIN=gcc-toolchain
      ;;

    --guix)
      shift
      set -x
      cat>${VRUN_GUIX_BASE_DIR}/.siconos-disks-manifest.scm<<EOF
(specifications->manifest
 '(
 "$VRUN_GUIX_CXX_TOOLCHAIN"
 "bash"
 "benchmark"
 "boost"
 "bullet"
 "cmake"
 "coreutils"
 "cppunit"
 "cuda-toolkit"
 "eigen"
 "emacs-next"
 "fclib"
 "findutils"
 "fmt"
 "fmt"
 "gdb"
 "gfortran-toolchain"
 "git"
 "gmp"
 "jupyter"
 "lapack"
 "lpsolve"
 "make"
 "ninja"
 "nlohmann-json"
 "openblas"
 "parallel"
 "petsc"
 "procps"
 "pybind11"
 "python"
 "python-h5py"
 "python-ipykernel"
 "python-lxml"
 "python-numpy@1.26"
 "python-packaging"
 "python-pip"
 "python-pytest"
 "python-scikit-build"
 "python-scipy"
 "python-setuptools"
 "python-wheel"
 "range-v3"
 "rsync"
 "strace"
 "suitesparse"
 "swig"
 "time"
 "valgrind"
 "vtk"
 "which"
 "xvfb-run"
))
EOF

      cat>${VRUN_GUIX_BASE_DIR}/.siconos-vrun-channels.scm<<EOF
(list (channel
        (name 'guix-science-nonfree)
        (url "https://codeberg.org/guix-science/guix-science-nonfree.git")
        (branch "master")
        (commit
          "86f3bd89a211eddc4db273de8ce6cf3bbfccfba1")
        (introduction
          (make-channel-introduction
            "58661b110325fd5d9b40e6f0177cc486a615817e"
            (openpgp-fingerprint
              "CA4F 8CF4 37D7 478F DA05  5FD4 4213 7701 1A37 8446"))))
      (channel
        (name 'guix)
        (url "https://codeberg.org/guix/guix-mirror")
        (branch "master")
        (commit
          "356cc64411f7fa2c2dbf35f72f8be4957f00dce0")
        (introduction
          (make-channel-introduction
            "9edb3f66fd807b096b48283debdcddccfea34bad"
            (openpgp-fingerprint
              "BBB0 2DDF 2CEA F6A8 0D1D  E643 A2A0 6DF2 A33A 54FA"))))
      (channel
        (name 'guix-science)
        (url "https://codeberg.org/Maurice/guix-science.git")
        (branch "add-siconos")
        (commit
          "fd0063327c3faf318a6ec43895dbb0c19587004e"))
      (channel
        (name 'guix-past)
        (url "https://codeberg.org/guix-science/guix-past.git")
        (branch "master")
        (commit
          "a6fc9859837de4a3d8cc824845f8bd28f68c530f")
        (introduction
          (make-channel-introduction
            "0c119db2ea86a389769f4d2b9c6f5c41c027e336"
            (openpgp-fingerprint
              "3CE4 6455 8A84 FDC6 9DB4  0CFB 090B 1199 3D9A EBB5")))))
EOF
      # guix environment setup
      # export PATH=/var/guix/profiles/per-user/root/current-guix/bin:$PATH
      # export GUIX_DAEMON_SOCKET=guix://luke.u-ga.fr
      if [ -f /applis/site/guix-start.sh ]; then
        . /applis/site/guix-start.sh
        guix_isolation_args="--container -N --emulate-fhs --share=/tmp --share=/bettik --share=$HOME"
      else
        guix_isolation_args="--container -N --emulate-fhs --share=/tmp --share=/scratch --share=$HOME"
      fi
      rm -f ${VRUN_GUIX_BASE_DIR}/.siconos-guix-profile
      #guix_isolation_args="--pure --preserve=OMP* --preserve=VRUN*"
      guix_cmd="guix time-machine -C ${VRUN_GUIX_BASE_DIR}/.siconos-vrun-channels.scm --"
      # it seems that we need to pass explicitely the package for transformations
      exec $guix_cmd shell $guix_isolation_args \
           --root=${VRUN_GUIX_BASE_DIR}/.siconos-guix-profile \
           -m ${VRUN_GUIX_BASE_DIR}/.siconos-disks-manifest.scm \
           -- $0 "$@"
      ;;

    --time)
      shift
      timer="$time"
      timer_args="$1"
      shift
      ;;

    --help)
      cat ${mydir}/README.md
      exit 0
      ;;

    *)
      set -x
      script=$1
      suffix="${script##*.}"
      case $suffix in py) interp=python3;; *) interp="";; esac
      shift
      args=()
      while [[ $# -gt 0 && "$1" != "--" ]]; do
        args+=("$1")
        shift
      done
      if [[ $# -gt 0 && "$1" == "--" ]]; then
        shift
        xex=""
      else
        xex="exec"
      fi
      if [ -f ${venv}/bin/activate ]; then
        . ${venv}/bin/activate
        python_version=`python3 -c 'import sys; print(".".join(map(str, sys.version_info[:2])))'`
        python_site_packages_path=`python3 -c 'import os; import sys; print(os.path.join(sys.prefix, "lib", "python" + sys.version[:3], "site-packages"))'`
        export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:`pwd`/${venv}/lib/python${python_version}/site-packages/nonos/
      fi

      case "$(basename "$script")" in
        python|python3) script="$(command -v "$script")" ;;
      esac

      # Construit la commande finale comme tableau
      cmd=()
      if [ -n "$timer" ]; then
        cmd+=("$time" -f "$timer_args")
      fi
      if [ -n "$interp" ]; then
        cmd+=("$interp")
      fi
      cmd+=("$script")
      cmd+=("${args[@]}")

      if [ -n "$xex" ]; then
        exec "${cmd[@]}"
      else
        "${cmd[@]}"
      fi
      ;;
  esac
done
