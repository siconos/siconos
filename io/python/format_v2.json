      "solver_name": {"dtype": "str", "mode": 2, "by": "index_param", "shape": []},
      "integer_param_range": {"dtype": "u64", "mode": 2, "by": "index_param", "shape": [2]},
      "double_param_range": {"dtype": "u64", "mode": 2, "by": "index_param", "shape": [2]},
      "integer_params": {"dtype": "i32", "mode": 2, "by": "integer_param_range", "shape": []}, // verifier int type
      "double_params": {"dtype": "f64", "mode": 2, "by": "double_param_range", "shape": []},
      "n_iterations": {"dtype": "int_type", "mode": 2, "by": "index_var", "shape": []},
      "precision": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []},
      "local_precision": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []}
    },
    "newton_solver": {
      "index_var": {"dtype": "u64", "mode": 2, "by": "../../time", "shape": [2]},
      "n_iterations": {"dtype": "int_type", "mode": 2, "by": "index_var", "shape": []},
      "precision": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []}
    }
  },
  "diagnostics": {
