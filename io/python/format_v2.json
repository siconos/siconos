    "subshape_range": {"dtype": "u64", "mode": 1, "by": "index_param", "shape": [2]},
    "subshape_index": {"dtype": "int_type", "mode": 1, "by": "subshape_range", "shape": []}
  },
  "nslaws": {
    "index_param": {"dtype": "u64", "mode": 1, "by": "../time", "shape": [2]},
    "id": {"dtype": "int_type", "mode": 1, "by": "index_param", "shape": []},
    "name": {"dtype": "str", "mode": 1, "by": "index_param", "shape": []},
    "type": {"dtype": "u8", "mode": 1, "by": "index_param", "shape": [],
             "enum": ["NewtonImpactFrictionNSL", "NewtonImpactRollingFrictionNSL",
                      "NewtonImpactNSL", "RelayNSL", "FremondImpactFrictionNSL",
                      "BinaryCohesiveNSL", "EqualityConditionNSL", "other"]},
    "group_ids": {"dtype": "int_type", "mode": 1, "by": "index_param", "shape": [2]},
    "param_range": {"dtype": "u64", "mode": 1, "by": "index_param", "shape": [2]},
    "params": {"dtype": "float_type", "mode": 1, "by": "param_range", "shape": [],
               "layout": {"NewtonImpactFrictionNSL": ["e", "mu"],
                          "NewtonImpactRollingFrictionNSL": ["e", "mu", "mu_r"],
                          "NewtonImpactNSL": ["e"],
                          "RelayNSL": ["size", "lb", "ub"],
                          "FremondImpactFrictionNSL": ["e", "mu"],
                          "BinaryCohesiveNSL": ["e", "mu", "sigma_c", "delta_c", "gamma"],
                          "EqualityConditionNSL": ["size"]}}
  },
  "interactions": {
    "index_var": {"dtype": "u64", "mode": 1, "by": "../time", "shape": [2]},
    "name": {"dtype": "str", "mode": 1, "by": "index_var", "shape": []},
    "type": {"dtype": "u8", "mode": 1, "by": "index_var", "shape": [],
             "enum": ["PivotJointR", "KneeJointR", "PrismaticJointR", "CylindricalJointR",
                      "FixedJointR", "CouplerJointR", "OccR",
                      "NewtonEuler3DR", "ContactR", "Contact2dR", "Contact2d3DR", "other"]},
    "nslaw": {"dtype": "int_type", "mode": 1, "by": "index_var", "shape": []},
    "bodies": {"dtype": "int_type", "mode": 1, "by": "index_var", "shape": [2]},
    "contactors": {"dtype": "int_type", "mode": 1, "by": "index_var", "shape": [2]},
    "param_range": {"dtype": "u64", "mode": 1, "by": "index_var", "shape": [2]},
    "params": {"dtype": "float_type", "mode": 1, "by": "param_range", "shape": [],
               "layout": {"OccR": ["offset1", "offset2", "distance_calculator"],
                          "PivotJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                          "KneeJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                          "PrismaticJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                          "CylindricalJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                          "FixedJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                          "CouplerJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                          "other": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"]}}
  },
  "contacts": {
