      "timing": {"dtype": "f64", "mode": 2, "by": "index_var", "shape": []},
      "value_range": {"dtype": "u64", "mode": 2, "by": "index_var", "shape": [2]},
      "value": {"dtype": "f64", "mode": 2, "by": "value_range", "shape": []}
    }
  },
  "boundary_conditions": { // Dirichlet, Neumann, Robin, Periodic -> v2.1
    "Dirichlet": { //
    },
    "Neumann" : { // Spring

    },
    "index_param": {"dtype": "u64", "mode": 1, "by": "../time", "shape": [2]},
    "name": {"dtype": "str", "mode": 1, "by": "index_param", "shape": []},
