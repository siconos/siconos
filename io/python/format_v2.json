    "interaction": {"dtype": "int_type", "mode": 1, "by": "index_var", "shape": []}, // ligne dans le bloc k de interactions
    "point_a": {"dtype": "float_type", "mode": 1, "by": "index_var", "shape": ["dim"]},
    "point_b": {"dtype": "float_type", "mode": 1, "by": "index_var", "shape": ["dim"]},
    "normal": {"dtype": "float_type", "mode": 1, "by": "index_var", "shape": ["dim"]},
    "reaction_local": {"dtype": "float_type", "mode": 1, "by": "index_var", "shape": ["reaction"]},
