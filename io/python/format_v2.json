{
  "doc": {
    "source": "format v2 (version_major = 2): every entry is addressed by the index named in 'by'; same grammar as format_v1.json, with the differences below",
    "plan": ["Plan 2.0 : portage et boundary sans distinction entre Neumann & Dirichlet.", "Plan 2.1 : gestion des boundary conditions avec un type, Un rechargement à froid devrait marcher", "Plan 2.2 : le rechargement à chaud devrait marcher", "compression param : tjrs, compress var : optionnel"],
    "dtype": "numpy names: f8, f4, i8, i4, u8 (uint64), u1 (uint8); float_type, int_type: the type given by the attribute of the same name, the data are converted to it when written; bool; str: short utf-8 string (names); vlen: large text (STEP, BREP, mesh, scripts)",
    "shape": "full dataset shape; null = free size (None, as in numpy), the first dimension being the one set by 'by'; a symbol takes its value from symbols for the dimension of the file, null in symbols = set by the writer when the dataset is created",
    "by": "the index that addresses the rows of the dataset: index_param (parameters, registries), index_var (states), *_range (blocks of variable length), *_id, the index of another group (relative path), ../time; absent: written once",
    "mode": "0: light, 1: classic, 2: heavy; an entry of mode m is written if the mode of the file >= m",
    "compression": "a block of index_param identical to the previous one is not written again (the index row repeats the previous one), a registry that only grows keeps its start (registries); the same for index_var when the attribute compress_var is true (state reuse); plus the gzip filter of HDF5 on the tables",
    "attributes": "attributes of the file: const: imposed value; enum: allowed values; default: value when not given",
    "attrs": "HDF5 attributes of a group, written when the group is created; enum: allowed values, stored as strings",
    "enum": "on a u1 dataset: stored value = position of the name in the list",
    "layout": "content of a params buffer: list of names, or dict type -> list; 'x[k]' = block of k values, k an integer, the name of a field already read, 'n' (number of dofs in dof_range) or '*' (rest of the block)",
    "<name>": "group named at write time: log/<fn> (one logged function), script/plugins/<plugin> (one plugin), fem/fields/<field> (one field)",
    "reserved": "contacts_diagnostics: group reserved for a later version",
    "registries": "a registry that only grows keeps the same start: index_param[k] = (0, n_k); the block is rewritten only when rows disappear",
    "alignment": "in bodies, fixed_bodies and fem/fields/<field>, row i of the state block k describes row i of the registry block k (same length, same order): no per-row id in the states",
    "state reuse": "an index_var row may repeat the previous block when the state did not change (e.g. motionless fixed bodies)",
    "interactions": "one row = one Siconos Interaction (relation + nonsmooth law), declared (joints, OccR) or created at run time (contacts); the block of step k lists the interactions alive at step k; contacts/interaction = row in that block, not a Siconos number: the writer keeps a hash table Siconos number -> row of the current block, the reader indexes directly; bodies and contactors are read from the interaction row",
    "log": "log/<fn>/timing[i] = i-th call; index_var[k] = calls made between output k-1 and output k; value[value_range[i,0]:value_range[i,1]] = its value, empty if it is not a number",
    "boundary_conditions": "body -> bodies/id (object1 in v1, which was a name); a v1 scalar is repeated n times; BoundaryCondition without v (zero velocity): empty param_range",
    "fem": "a FE body is a body (fem/body -> bodies/id); mesh of simplices only (triangles 2D, tetrahedra 3D), node indices local to the body; remeshing rewrites the registry block",
    "fem fields": "values of row i: n_entities(space) rows of ncomp(kind) values; n_entities: P0DG = n_cells, P1 = n_nodes, P1DG = n_cells * (dim + 1) (cell by cell, nodes in cell order); ncomp: scalar = 1, vector = dim, sym_tensor = 3 in 2D (xx, yy, xy) / 6 in 3D (xx, yy, zz, yz, xz, xy), tensor = dim * dim (row-major)",
    "margins": "geometry/inside_margin, outside_margin: bullet backend only (empty otherwise); the effective value is written, defaults included (inside = 2 % of the smallest dimension, outside = 0)",
    "reaction": "width = maximum over the scene's laws (dim, +1 in 2D / +2 in 3D if a law has rolling); columns unused by the contact's law = 0 (zero rolling moment)"
  },
  "attributes": {
    "version_major": {"const": 2},
    "version_minor": {"const": 0},
    "dimension": {"enum": [2, 3], "default": 3},
    "float_type": {"enum": ["f8", "f4"], "default": "f8"},
    "int_type": {"enum": ["i8", "i4"], "default": "i8"},
    "mode": {"enum": [0, 1, 2], "default": 1},
    "compress_var": {"enum": [false, true], "default": false},
    "backend": {"enum": ["occ", "native", "vnative", "bullet"]}
  },
  "symbols": {
    "dim": {"2": 2, "3": 3},
    "rot": {"2": 1, "3": 4},
    "twist": {"2": 3, "3": 6},
    "idof": {"2": 1, "3": 3},
    "simplex": {"2": 3, "3": 4},
    "reaction": null,
    "n_internal": null,
    "ncomp": null
  },
  "data": {
    "time": {"dtype": "f8", "mode": 0, "shape": [null]},
    "geometry": {
      "index_param": {"dtype": "u8", "mode": 0, "by": "../time", "shape": [null, 2]},
      "id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": [null]},
      "name": {"dtype": "str", "mode": 0, "by": "index_param", "shape": [null]},
      "type": {"dtype": "u1", "mode": 0, "by": "index_param", "shape": [null],
               "enum": ["sphere", "box", "cylinder", "capsule", "cone", "disk", "circle", "box2d", "segment", "line", "convex", "heightmap", "mesh", "step", "brep", "vtp", "msh", "other"]},
      "param_range": {"dtype": "u8", "mode": 0, "by": "index_param", "shape": [null, 2]},
      "params": {"dtype": "float_type", "mode": 0, "by": "param_range", "shape": [null],
                 "layout": {"sphere": ["radius"],
                            "box": ["width", "height", "depth"],
                            "cylinder": ["radius", "length"],
                            "capsule": ["radius", "length"],
                            "cone": ["radius", "length"],
                            "disk": ["radius"],
                            "circle": ["radius"],
                            "box2d": ["thickness", "size"],
                            "segment": ["x1", "y1", "x2", "y2"],
                            "line": ["a", "b", "c"],
                            "convex": ["vertices[*]"],
                            "heightmap": ["rect[2]", "nrows", "ncols", "heights[*]"]}},
      "inside_margin": {"dtype": "float_type", "mode": 1, "by": "index_param", "shape": [null]},
      "outside_margin": {"dtype": "float_type", "mode": 1, "by": "index_param", "shape": [null]},
      "content_id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": [null]},
      "content": {"dtype": "vlen", "mode": 0, "by": "content_id", "shape": [null]}
    },
    "bodies": {
      "index_param": {"dtype": "u8", "mode": 0, "by": "../time", "shape": [null, 2]},
      "index_var": {"dtype": "u8", "mode": 0, "by": "../time", "shape": [null, 2]},
      "id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": [null]},
      "name": {"dtype": "str", "mode": 0, "by": "index_param", "shape": [null]},
      "center_of_mass": {"dtype": "float_type", "mode": 0, "by": "index_param", "shape": [null, "dim"]},
      "mass": {"dtype": "float_type", "mode": 1, "by": "index_param", "shape": [null], "note": "runtime"},
      "inertia": {"dtype": "float_type", "mode": 1, "by": "index_param", "shape": [null, "idof", "idof"]},
      "allow_self_collide": {"dtype": "bool", "mode": 2, "by": "index_param", "shape": [null]},
      "position": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": [null, "dim"]},
      "orientation": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": [null, "rot"]},
      "velocity": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": [null, "twist"]}
    },
    "fixed_bodies": {
      "index_param": {"dtype": "u8", "mode": 0, "by": "../time", "shape": [null, 2]},
      "index_var": {"dtype": "u8", "mode": 0, "by": "../time", "shape": [null, 2]},
      "id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": [null]},
      "name": {"dtype": "str", "mode": 0, "by": "index_param", "shape": [null]},
      "center_of_mass": {"dtype": "float_type", "mode": 0, "by": "index_param", "shape": [null, "dim"]},
      "position": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": [null, "dim"]},
      "orientation": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": [null, "rot"]}
    },
    "contactors": {
      "index_param": {"dtype": "u8", "mode": 0, "by": "../time", "shape": [null, 2]},
      "id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": [null]},
      "name": {"dtype": "str", "mode": 0, "by": "index_param", "shape": [null]},
      "body": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": [null]},
      "geometry": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": [null]},
      "translation": {"dtype": "float_type", "mode": 0, "by": "index_param", "shape": [null, "dim"]},
      "orientation": {"dtype": "float_type", "mode": 0, "by": "index_param", "shape": [null, "rot"]},
      "group": {"dtype": "int_type", "mode": 1, "by": "index_param", "shape": [null]},
      "subshape": {"dtype": "u1", "mode": 1, "by": "index_param", "shape": [null],
                   "note": "Verifier les noms dans occ sinon subgeometry",
                   "enum": ["shape", "face", "edge"]},
      "subshape_range": {"dtype": "u8", "mode": 1, "by": "index_param", "shape": [null, 2]},
      "subshape_index": {"dtype": "int_type", "mode": 1, "by": "subshape_range", "shape": [null]}
    },
    "nslaws": {
      "index_param": {"dtype": "u8", "mode": 1, "by": "../time", "shape": [null, 2]},
      "id": {"dtype": "int_type", "mode": 1, "by": "index_param", "shape": [null]},
      "name": {"dtype": "str", "mode": 1, "by": "index_param", "shape": [null]},
      "type": {"dtype": "u1", "mode": 1, "by": "index_param", "shape": [null],
               "enum": ["NewtonImpactFrictionNSL", "NewtonImpactRollingFrictionNSL", "NewtonImpactNSL", "RelayNSL", "FremondImpactFrictionNSL", "BinaryCohesiveNSL", "EqualityConditionNSL", "other"]},
      "group_ids": {"dtype": "int_type", "mode": 1, "by": "index_param", "shape": [null, 2]},
      "param_range": {"dtype": "u8", "mode": 1, "by": "index_param", "shape": [null, 2]},
      "params": {"dtype": "float_type", "mode": 1, "by": "param_range", "shape": [null],
                 "layout": {"NewtonImpactFrictionNSL": ["e", "mu"],
                            "NewtonImpactRollingFrictionNSL": ["e", "mu", "mu_r"],
                            "NewtonImpactNSL": ["e"],
                            "RelayNSL": ["size", "lb", "ub"],
                            "FremondImpactFrictionNSL": ["e", "mu"],
                            "BinaryCohesiveNSL": ["e", "mu", "sigma_c", "delta_c", "gamma"],
                            "EqualityConditionNSL": ["size"]}}
    },
    "interactions": {
      "index_var": {"dtype": "u8", "mode": 1, "by": "../time", "shape": [null, 2]},
      "name": {"dtype": "str", "mode": 1, "by": "index_var", "shape": [null]},
      "type": {"dtype": "u1", "mode": 1, "by": "index_var", "shape": [null],
               "enum": ["PivotJointR", "KneeJointR", "PrismaticJointR", "CylindricalJointR", "FixedJointR", "CouplerJointR", "OccR", "NewtonEuler3DR", "ContactR", "Contact2dR", "Contact2d3DR", "other"]},
      "nslaw": {"dtype": "int_type", "mode": 1, "by": "index_var", "shape": [null]},
      "bodies": {"dtype": "int_type", "mode": 1, "by": "index_var", "shape": [null, 2]},
      "contactors": {"dtype": "int_type", "mode": 1, "by": "index_var", "shape": [null, 2]},
      "param_range": {"dtype": "u8", "mode": 1, "by": "index_var", "shape": [null, 2]},
      "params": {"dtype": "float_type", "mode": 1, "by": "param_range", "shape": [null],
                 "layout": {"OccR": ["offset1", "offset2", "distance_calculator"],
                            "PivotJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                            "KneeJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                            "PrismaticJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                            "CylindricalJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                            "FixedJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                            "CouplerJointR": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"],
                            "other": ["absolute", "n_points", "points[3*n_points]", "n_axes", "axes[3*n_axes]", "n_coupled", "coupled[3*n_coupled]"]}}
    },
    "contacts": {
      "index_var": {"dtype": "u8", "mode": 1, "by": "../time", "shape": [null, 2]},
      "interaction": {"dtype": "int_type", "mode": 1, "by": "index_var", "shape": [null],
                      "note": "ligne dans le bloc k de interactions"},
      "point_a": {"dtype": "float_type", "mode": 1, "by": "index_var", "shape": [null, "dim"]},
      "point_b": {"dtype": "float_type", "mode": 1, "by": "index_var", "shape": [null, "dim"]},
      "normal": {"dtype": "float_type", "mode": 1, "by": "index_var", "shape": [null, "dim"]},
      "reaction_local": {"dtype": "float_type", "mode": 1, "by": "index_var", "shape": [null, "reaction"]},
      "subshape1": {"dtype": "int_type", "mode": 2, "by": "index_var", "shape": [null]},
      "subshape2": {"dtype": "int_type", "mode": 2, "by": "index_var", "shape": [null]}
    },
    "solvers": {
      "contact_solver": {
        "index_var": {"dtype": "u8", "mode": 2, "by": "../../time", "shape": [null, 2]},
        "index_param": {"dtype": "u8", "mode": 2, "by": "../../time", "shape": [null, 2]},
        "solver_name": {"dtype": "str", "mode": 2, "by": "index_param", "shape": [null]},
        "integer_param_range": {"dtype": "u8", "mode": 2, "by": "index_param", "shape": [null, 2]},
        "double_param_range": {"dtype": "u8", "mode": 2, "by": "index_param", "shape": [null, 2]},
        "integer_params": {"dtype": "i4", "mode": 2, "by": "integer_param_range", "shape": [null],
                           "note": "verifier int type"},
        "double_params": {"dtype": "f8", "mode": 2, "by": "double_param_range", "shape": [null]},
        "n_iterations": {"dtype": "int_type", "mode": 2, "by": "index_var", "shape": [null]},
        "precision": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null]},
        "local_precision": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null]}
      },
      "newton_solver": {
        "index_var": {"dtype": "u8", "mode": 2, "by": "../../time", "shape": [null, 2]},
        "n_iterations": {"dtype": "int_type", "mode": 2, "by": "index_var", "shape": [null]},
        "precision": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null]}
      }
    },
    "diagnostics": {
      "index_var": {"dtype": "u8", "mode": 2, "by": "../time", "shape": [null, 2]},
      "kinetic": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null]},
      "force_work": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null]},
      "work_n": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null],
                 "note": "verifier si c'est un doublon de contact_work"},
      "work_t": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null],
                 "note": "verifier si c'est un doublon de contact_work"},
      "work_n_theta": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null],
                       "note": "verifier si c'est un doublon de contact_work"},
      "work_t_theta": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null],
                       "note": "verifier si c'est un doublon de contact_work"},
      "work_n_neg": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null],
                     "note": "verifier si c'est un doublon de contact_work"},
      "work_t_neg": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": [null],
                     "note": "verifier si c'est un doublon de contact_work"},
      "contact_gap": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": [null, "dim"]},
      "contact_relative_velocity": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": [null, "dim"]},
      "contact_reaction_global": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": [null, "dim"]},
      "contact_work": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": [null, 5],
                       "layout": ["w_n", "w_t", "w_n_theta", "w_t_theta", "w_n_pos"]},
      "contact_status": {"dtype": "int_type", "mode": 2, "by": "../contacts/index_var", "shape": [null]},
      "contact_internal_variables": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": [null, "n_internal"]}
    },
    "fem": {
      "note": "Groups : Finite element problems. Registre : maillage par corps FE (remaillage rare -> nouveau bloc). Champs : un groupe par champ, espace et nature en attributs, une ligne par corps FE et par pas, alignée sur le registre.",
      "index_param": {"dtype": "u8", "mode": 0, "by": "../time", "shape": [null, 2]},
      "body": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": [null]},
      "node_range": {"dtype": "u8", "mode": 0, "by": "index_param", "shape": [null, 2]},
      "nodes": {"dtype": "float_type", "mode": 0, "by": "node_range", "shape": [null, "dim"]},
      "cell_range": {"dtype": "u8", "mode": 0, "by": "index_param", "shape": [null, 2]},
      "cells": {"dtype": "int_type", "mode": 0, "by": "cell_range", "shape": [null, "simplex"]},
      "fields": {
        "<field>": {
          "attrs": {
            "space": {
              "enum": ["P0DG", "P1", "P1DG"]
            },
            "kind": {
              "enum": ["scalar", "vector", "sym_tensor", "tensor"]
            }
          },
          "index_var": {"dtype": "u8", "mode": 0, "by": "../../../time", "shape": [null, 2]},
          "value_range": {"dtype": "u8", "mode": 0, "by": "index_var", "shape": [null, 2]},
          "values": {"dtype": "float_type", "mode": 0, "by": "value_range", "shape": [null, "ncomp"]}
        }
      }
    },
    "log": {
      "<fn>": {
        "index_var": {"dtype": "u8", "mode": 2, "by": "../../time", "shape": [null, 2]},
        "timing": {"dtype": "f8", "mode": 2, "by": "index_var", "shape": [null]},
        "value_range": {"dtype": "u8", "mode": 2, "by": "index_var", "shape": [null, 2]},
        "value": {"dtype": "f8", "mode": 2, "by": "value_range", "shape": [null]}
      }
    },
    "boundary_conditions": {
      "note": "Dirichlet, Neumann (spring), Robin, Periodic -> v2.1",
      "index_param": {"dtype": "u8", "mode": 1, "by": "../time", "shape": [null, 2]},
      "name": {"dtype": "str", "mode": 1, "by": "index_param", "shape": [null]},
      "type": {"dtype": "u1", "mode": 1, "by": "index_param", "shape": [null],
               "enum": ["HarmonicBC", "BoundaryCondition", "other"]},
      "body": {"dtype": "int_type", "mode": 1, "by": "index_param", "shape": [null]},
      "dof_range": {"dtype": "u8", "mode": 1, "by": "index_param", "shape": [null, 2]},
      "indices": {"dtype": "int_type", "mode": 1, "by": "dof_range", "shape": [null]},
      "param_range": {"dtype": "u8", "mode": 1, "by": "index_param", "shape": [null, 2]},
      "params": {"dtype": "float_type", "mode": 1, "by": "param_range", "shape": [null],
                 "layout": {"HarmonicBC": ["a[n]", "b[n]", "omega[n]", "phi[n]"], "BoundaryCondition": ["v[n]"]}}
    },
    "script": {
      "source": {"dtype": "vlen", "mode": 1, "shape": []},
      "plugins": {
        "<plugin>": {
          "source": {"dtype": "vlen", "mode": 1, "shape": []},
          "filename": {"dtype": "str", "mode": 1, "shape": []}
        }
      },
      "run_options": {"dtype": "vlen", "mode": 1, "shape": []}
    }
  }
}
