{
// Plan 2.0 : portage et boundary sans distinction entre Neumann & Dirichlet.
// Plan 2.1 : gestion des boundary conditions avec un type, Un rechargement à froid devrait marcher
// Plan 2.2 : le rechargement à chaud devrait marcher
// compression param : tjrs, compress var : optionnel
  "doc": {
    "dtype": "f64, f32, i64, i32, u64, u32, u8: fixed types; float_type, int_type; bool; str: short utf-8 string (names); vlen: large text (STEP, BREP, mesh, scripts)",
    "mode": "0: light, 1: classic, 2: heavy; a field of mode m is written if the file mode >= m",
    "shape": "dimensions after the first one; the first one is set by 'by' (S for index_*, N for a registry, T for a state)",
    "by": "what addresses the dataset: index_param, index_var, *_range, *_id, the index of another group (relative path), ../time, or none",
    "attributes": "const: imposed value; enum: list of allowed values",
    "attrs": "HDF5 attributes of a group, written when the group is created; enum: allowed values, stored as strings",
    "enum": "on a u8 field: stored value = position of the name in the list",
    "<name>": "group named at write time: log/<fn> (one logged function), script/plugins/<plugin> (one plugin), fem/fields/<field> (one field)",
    "layout": "content of a params buffer: list of names, or dict type -> list; 'x[k]' = block of k values, k an integer, the name of a field already read, 'n' (number of dofs in dof_range) or '*' (rest of the block)",
    "registries": "a registry that only grows keeps the same start: index_param[k] = (0, n_k); the block is rewritten only when rows disappear",
    "alignment": "in bodies, fixed_bodies and fem/fields/<field>, row i of the state block k describes row i of the registry block k (same length, same order): no per-row id in the states",
    "state reuse": "an index_var row may repeat the previous block when the state did not change (e.g. motionless fixed bodies)",
    "interactions": "one row = one Siconos Interaction (relation + nonsmooth law), declared (joints, OccR) or created at run time (contacts); the block of step k lists the interactions alive at step k; contacts/interaction = row in that block, not a Siconos number: the writer keeps a hash table Siconos number -> row of the current block, the reader indexes directly; bodies and contactors are read from the interaction row",
    "log": "log/<fn>/timing[i] = i-th call; index_var[k] = calls made between output k-1 and output k; value[value_range[i,0]:value_range[i,1]] = its value, empty if it is not a number",
    "boundary_conditions": "body -> bodies/id (object1 in v1, which was a name); a v1 scalar is repeated n times; BoundaryCondition without v (zero velocity): empty param_range",
    "fem": "a FE body is a body (fem/body -> bodies/id); mesh of simplices only (triangles 2D, tetrahedra 3D), node indices local to the body; remeshing rewrites the registry block",
    "fem fields": "values of row i: n_entities(space) rows of ncomp(kind) values; n_entities: P0DG = n_cells, P1 = n_nodes, P1DG = n_cells * (dim + 1) (cell by cell, nodes in cell order); ncomp: scalar = 1, vector = dim, sym_tensor = 3 in 2D (xx, yy, xy) / 6 in 3D (xx, yy, zz, yz, xz, xy), tensor = dim * dim (row-major)",
    "symbols": "value depends on the dimension attribute; runtime: set by the writer when the dataset is created",
    "margins": "geometry/inside_margin, outside_margin: bullet backend only (empty otherwise); the effective value is written, defaults included (inside = 2 % of the smallest dimension, outside = 0)",
    "reaction": "width = maximum over the scene's laws (dim, +1 in 2D / +2 in 3D if a law has rolling); columns unused by the contact's law = 0 (zero rolling moment)"
  },
  "attributes": {
    "version_major": {"const": 2},
    "version_minor": {"const": 0},
    "dimension": {"enum": [2, 3]},
    "float_type": {"enum": ["f64", "f32"]},
    "int_type": {"enum": ["i64", "i32"]},
    "mode": {"enum": [0, 1, 2]},
    "backend": {"enum": ["occ", "native", "vnative", "bullet"]}
  },
  "symbols": {
    "dim": {"2": 2, "3": 3},
    "rot": {"2": 1, "3": 4},
    "twist": {"2": 3, "3": 6},
    "idof": {"2": 1, "3": 3},
    "simplex": {"2": 3, "3": 4},
    "reaction": "runtime",
    "n_internal": "runtime",
    "ncomp": "runtime"
  },
  "time": {"dtype": "f64", "mode": 0, "by": "none", "shape": []},
  "geometry": {
    "index_param": {"dtype": "u64", "mode": 0, "by": "../time", "shape": [2]},
    "id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": []},
    "name": {"dtype": "str", "mode": 0, "by": "index_param", "shape": []},
    "type": {"dtype": "u8", "mode": 0, "by": "index_param", "shape": [],
             "enum": ["sphere", "box", "cylinder", "capsule", "cone", "disk", "circle", "box2d",
                      "segment", "line", "convex", "heightmap", "mesh", "step", "brep", "vtp",
                      "msh", "other"]},
    "param_range": {"dtype": "u64", "mode": 0, "by": "index_param", "shape": [2]},
    "params": {"dtype": "float_type", "mode": 0, "by": "param_range", "shape": [],
               "layout": {"sphere": ["radius"], "box": ["width", "height", "depth"],
                          "cylinder": ["radius", "length"], "capsule": ["radius", "length"],
                          "cone": ["radius", "length"], "disk": ["radius"], "circle": ["radius"],
                          "box2d": ["thickness", "size"], "segment": ["x1", "y1", "x2", "y2"],
                          "line": ["a", "b", "c"], "convex": ["vertices[*]"],
                          "heightmap": ["rect[2]", "nrows", "ncols", "heights[*]"]}},
    "inside_margin": {"dtype": "float_type", "mode": 1, "by": "index_param", "shape": []},
    "outside_margin": {"dtype": "float_type", "mode": 1, "by": "index_param", "shape": []},
    "content_id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": []},
    "content": {"dtype": "vlen", "mode": 0, "by": "content_id", "shape": []}
  },
  "bodies": {
    "index_param": {"dtype": "u64", "mode": 0, "by": "../time", "shape": [2]},
    "index_var": {"dtype": "u64", "mode": 0, "by": "../time", "shape": [2]},
    "id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": []},
    "name": {"dtype": "str", "mode": 0, "by": "index_param", "shape": []},
    "center_of_mass": {"dtype": "float_type", "mode": 0, "by": "index_param", "shape": ["dim"]},
    "mass": {"dtype": "float_type", "mode": 1, "by": "index_param", "shape": []}, //runtime
    "inertia": {"dtype": "float_type", "mode": 1, "by": "index_param", "shape": ["idof", "idof"]},
    "allow_self_collide": {"dtype": "bool", "mode": 2, "by": "index_param", "shape": []},
    "position": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": ["dim"]},
    "orientation": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": ["rot"]},
    "velocity": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": ["twist"]}
  },
  "fixed_bodies": {
    "index_param": {"dtype": "u64", "mode": 0, "by": "../time", "shape": [2]},
    "index_var": {"dtype": "u64", "mode": 0, "by": "../time", "shape": [2]},
    "id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": []},
    "name": {"dtype": "str", "mode": 0, "by": "index_param", "shape": []},
    "center_of_mass": {"dtype": "float_type", "mode": 0, "by": "index_param", "shape": ["dim"]},
    "position": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": ["dim"]},
    "orientation": {"dtype": "float_type", "mode": 0, "by": "index_var", "shape": ["rot"]}
  },

  "contactors": {
    "index_param": {"dtype": "u64", "mode": 0, "by": "../time", "shape": [2]},
    "id": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": []},
    "name": {"dtype": "str", "mode": 0, "by": "index_param", "shape": []},
    "body": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": []},
    "geometry": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": []},
    "translation": {"dtype": "float_type", "mode": 0, "by": "index_param", "shape": ["dim"]},
    "orientation": {"dtype": "float_type", "mode": 0, "by": "index_param", "shape": ["rot"]},
    "group": {"dtype": "int_type", "mode": 1, "by": "index_param", "shape": []},
    "subshape": {"dtype": "u8", "mode": 1, "by": "index_param", "shape": [], // Verifier les noms dans occ sinon subgeometry
