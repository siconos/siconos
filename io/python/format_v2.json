    "kinetic": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []},
    "force_work": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []},
    "work_n": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []}, // verifier si c'est un doublon de contact_work
    "work_t": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []}, // verifier si c'est un doublon de contact_work
    "work_n_theta": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []}, // verifier si c'est un doublon de contact_work
    "work_t_theta": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []}, // verifier si c'est un doublon de contact_work
    "work_n_neg": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []}, // verifier si c'est un doublon de contact_work
    "work_t_neg": {"dtype": "float_type", "mode": 2, "by": "index_var", "shape": []}, // verifier si c'est un doublon de contact_work
    "contact_gap": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": ["dim"]},
    "contact_relative_velocity": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": ["dim"]},
    "contact_reaction_global": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": ["dim"]},
    "contact_work": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": [5],
             "layout": ["w_n", "w_t", "w_n_theta", "w_t_theta", "w_n_pos"]},
    "contact_status": {"dtype": "int_type", "mode": 2, "by": "../contacts/index_var", "shape": []},
    "contact_internal_variables": {"dtype": "float_type", "mode": 2, "by": "../contacts/index_var", "shape": ["n_internal"]}
  },
  // Groups : Finite element problems
  // Registre : maillage par corps FE (remaillage rare -> nouveau bloc). Champs : un groupe par champ,
  // espace et nature en attributs, une ligne par corps FE et par pas, alignée sur le registre.
  "fem": {
    "index_param": {"dtype": "u64", "mode": 0, "by": "../time", "shape": [2]},
    "body": {"dtype": "int_type", "mode": 0, "by": "index_param", "shape": []},
    "node_range": {"dtype": "u64", "mode": 0, "by": "index_param", "shape": [2]},
    "nodes": {"dtype": "float_type", "mode": 0, "by": "node_range", "shape": ["dim"]},
    "cell_range": {"dtype": "u64", "mode": 0, "by": "index_param", "shape": [2]},
    "cells": {"dtype": "int_type", "mode": 0, "by": "cell_range", "shape": ["simplex"]},
    "fields": {
      "<field>": {
        "attrs": {
          "space": {"enum": ["P0DG", "P1", "P1DG"]},
          "kind": {"enum": ["scalar", "vector", "sym_tensor", "tensor"]}
        },
        "index_var": {"dtype": "u64", "mode": 0, "by": "../../../time", "shape": [2]},
        "value_range": {"dtype": "u64", "mode": 0, "by": "index_var", "shape": [2]},
        "values": {"dtype": "float_type", "mode": 0, "by": "value_range", "shape": ["ncomp"]}
      }
    }
  },
  "log": {
